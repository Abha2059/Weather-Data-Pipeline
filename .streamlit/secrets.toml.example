# ==============================================================================
# Streamlit Community Cloud Secrets Template
#
# When deploying to Streamlit Community Cloud:
# 1. Open your app settings on https://share.streamlit.io
# 2. Navigate to "Secrets"
# 3. Paste the configuration below with your real RDS credentials:
# ==============================================================================

MYSQL_HOST = "weather-db.c9qcuiuy6x3m.ap-south-1.rds.amazonaws.com"
MYSQL_PORT = 3306
MYSQL_USER = "admin"
MYSQL_PASSWORD = "your_secure_rds_password"
MYSQL_DATABASE = "weather_db"

# Optional: AWS S3 Credentials for Gold Lakehouse Parquet access
AWS_DEFAULT_REGION = "ap-south-1"
AWS_S3_BUCKET = "weather-data-pipeline-abhay-699258776334"
# AWS_ACCESS_KEY_ID = "your_access_key_id"
# AWS_SECRET_ACCESS_KEY = "your_secret_access_key"
